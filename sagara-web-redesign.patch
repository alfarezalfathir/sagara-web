+  const [hero, setHero] = useState<HeroContent>(DEFAULT_HERO);
+  const [loading, setLoading] = useState(true);
+
+  useEffect(() => {
+    let active = true;
+    fetchHeroContent().then((data) => {
+      if (!active) return;
+      setHero(data);
+      setLoading(false);
+    });
+    return () => {
+      active = false;
+    };
+  }, []);
+
+  return { hero, loading };
+}
